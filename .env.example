# POEM Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — your secrets stay local.

# LLM API Keys (set whichever provider you're using)
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Azure OpenAI (if using Azure provider)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# Vector DB (pgvector is default, set automatically by docker-compose)
# PGVECTOR_CONNECTION_STRING=postgresql://poem:poem@localhost:5432/poem

# Pinecone (if using Pinecone provider)
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# Integrations
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# SLACK_WEBHOOK_URL=
